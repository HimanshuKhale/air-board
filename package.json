{
  "name": "hand-sign-projection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "ai:mock": "node server/ai.mjs",
    "ai": "node --env-file=.env server/ai.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "npm run setup:assets && npm run setup:worker",
    "check": "npm run test && npm run build",
    "setup:worker": "node scripts/build-worker.mjs",
    "predev": "npm run setup:worker",
    "prebuild": "npm run setup:worker"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
